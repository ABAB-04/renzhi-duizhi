static func get_withdraw_ending(round_index: int) -> Dictionary:
    if round_index <= 4:
        return ENDINGS["withdraw_early"]
    elif round_index <= 8:
        return ENDINGS["withdraw_mid"]
    else:
        return ENDINGS["withdraw_late"]


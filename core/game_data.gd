# 知识条目反查：category 是 "人身攻击 + 滑坡谬误" 这种复合串，按关键字匹配
static func lookup_knowledge(category: String) -> Dictionary:
    for entry in KNOWLEDGE_BASE:
        if entry.get("name", "") in category:
            return entry.duplicate() as Dictionary
    var empty: Dictionary = {}
    return empty

# 答题回合数值（兼容新回合号→旧数据映射）
static func get_quiz_deltas(round_num: int, correct: bool) -> Dictionary:
    var legacy_map: Dictionary = {2: 3, 5: 7}
    var legacy_r: int = int(legacy_map.get(round_num, round_num))
    var key: String = "correct" if correct else "wrong"
    var outer: Dictionary = QUIZ_DELTAS.get(legacy_r, {})
    var inner: Dictionary = outer.get(key, {})
    return inner
